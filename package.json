{
  "name": "sidebar-template",
  "version": "1.1.0-preview.1",
  "description": "Local-first desktop workbench for files, research, and agents",
  "main": "src/main/main.js",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "start": "npm run build && electron .",
    "dev": "npm start",
    "package": "npm run build && node scripts/package-preview.cjs",
    "dist": "npm run build && electron-builder",
    "build": "vite build",
    "test": "node --test test/*.test.cjs test/*.test.mjs",
    "test:packaged": "node scripts/test-packaged.cjs",
    "demo:seed": "node scripts/seed-demo.cjs",
    "test:inbox": "node scripts/test-packaged-inbox.cjs"
  },
  "keywords": [
    "electron",
    "desktop",
    "workbench"
  ],
  "author": "Workbench contributors",
  "license": "MIT",
  "devDependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/lexend": "5.3.0",
    "@fontsource-variable/martian-mono": "5.3.0",
    "@fontsource-variable/nunito": "5.3.0",
    "@fontsource-variable/playfair-display": "5.3.0",
    "@fontsource-variable/rethink-sans": "5.3.0",
    "@fontsource-variable/source-sans-3": "5.3.1",
    "@fontsource-variable/work-sans": "5.3.0",
    "@fontsource/barlow": "5.3.0",
    "@fontsource/courier-prime": "5.3.0",
    "@fontsource/crimson-text": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@fontsource/space-mono": "5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@uiw/react-codemirror": "^4.25.12",
    "@vitejs/plugin-react": "^6.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "45.3.3",
    "electron-builder": "^26.0.12",
    "lucide-react": "^1.73.0",
    "playwright-core": "1.65.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.3.8"
  },
  "build": {
    "appId": "com.template.sidebartemplate",
    "productName": "Workbench",
    "files": [
      "src/main/**/*",
      "renderer-dist/**/*",
      "package.json"
    ],
    "fileAssociations": [
      {
        "ext": [
          "md",
          "txt",
          "json",
          "csv",
          "tsv",
          "js",
          "jsx",
          "ts",
          "tsx",
          "py",
          "html",
          "css",
          "yaml",
          "yml",
          "xml",
          "toml",
          "sql",
          "sh",
          "go",
          "rs",
          "rb",
          "swift",
          "log"
        ],
        "name": "Workbench text file",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": [
          "pdf",
          "xlsx",
          "png",
          "jpeg",
          "jpg",
          "gif",
          "webp",
          "mp4",
          "webm",
          "mov",
          "mp3",
          "wav",
          "m4a"
        ],
        "name": "Workbench preview",
        "role": "Viewer",
        "rank": "Alternate"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage",
      "category": "Utility"
    }
  },
  "dependencies": {
    "@daytona/sdk": "0.232.0",
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@earendil-works/pi-mcp": "1.5.2",
    "diff": "9.0.0",
    "exceljs": "4.4.0",
    "node-pty": "1.1.0",
    "parse5": "7.3.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "^6.5.438",
    "yaml": "2.9.0",
    "yauzl": "3.4.0"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "overrides": {
    "openai": {
      "undici": "6.29.1"
    },
    "exceljs": {
      "uuid": "11.1.1"
    }
  },
  "homepage": "https://github.com/wstria/workbench",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wstria/workbench.git"
  },
  "bugs": {
    "url": "https://github.com/wstria/workbench/issues"
  }
}
